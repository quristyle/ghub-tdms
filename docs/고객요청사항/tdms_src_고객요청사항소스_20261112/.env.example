POSTGRES_USER=dms_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dms
DATABASE_URL=postgresql://dms_user:change_me@localhost:5432/dms
STORAGE_ROOT=C:\path\to\storage

# 로그인 쿠키 서명용 비밀 키 (필수, 32자 이상 — 없으면 서버가 켜지지 않는다)
# backend 폴더에서 아래 명령을 실행해 나온 값을 붙여 넣는다:
#   venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
# 이 값이 새어 나가면 로그인을 위조할 수 있으니 메신저·공유폴더에 올리지 말 것.
SECRET_KEY=

# 접속을 받을 주소 ("전용 복도"). 쉼표로 여러 개, 203.0.113.0/24처럼 범위로도 적을 수 있다.
# 이 컴퓨터에서만 쓰면 그대로 두고, 서버(Azure)에서는 회사 인터넷 주소를 더한다.
ALLOWED_CLIENT_IPS=127.0.0.1,::1

# 서버 실행 설정 (backend\run_server.py가 읽는다)
#   다른 컴퓨터에서도 들어오게 하려면 SERVER_HOST=0.0.0.0
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# https 인증서 파일 경로 — 둘 다 적으면 https로 실행되고 로그인 쿠키도 https에서만 오간다
SSL_CERTFILE=
SSL_KEYFILE=

# 원본(DWG·엑셀·워드·PPT) 미리보기 변환 (D-102) — 전부 비워 두면 기본값을 쓴다
#   오피스 변환: libreoffice(기본, 서버) / msoffice(회사 PC 시험용 — 엑셀만 됨)
PREVIEW_OFFICE_ENGINE=libreoffice
#   도구 위치 — 비워 두면 기본 설치 위치(LibreOffice) / C:\Program Files\ODA 밑 최신 버전(ODA)
PREVIEW_SOFFICE_PATH=
PREVIEW_ODA_PATH=
#   한 파일을 바꾸는 데 이보다 오래 걸리면(초) 멈추고 "미리보기를 만들 수 없음"으로 안내
PREVIEW_TIMEOUT_SECONDS=180

