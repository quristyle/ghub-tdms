# ── 데이터베이스 ───────────────────────────────────────────────
# 운영에서는 이 파일 대신 systemd LoadCredential= 을 쓴다.
PGHOST=jin114.co.kr
PGPORT=31015
PGDATABASE=ghub_tdms
PGUSER=ghub_tdms
PGPASSWORD=
PGSCHEMA=ghub_tdms
# 커넥션 풀 상한 (로컬 PG 기준 16 권장)
PG_POOL_MAX=16

# ── 세션 ──────────────────────────────────────────────────────
# 32자 이상. 없으면 서버가 켜지지 않는다.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_HOURS=12

# ── 서버 ──────────────────────────────────────────────────────
# 운영: unix 소켓. 개발: 포트
API_LISTEN=0.0.0.0:8080
# API_LISTEN=/run/tdms/api.sock
NODE_ENV=development
LOG_LEVEL=info

# nginx 뒤에서 동작하면 true — 파일 전송을 X-Accel-Redirect 로 위임한다.
# false 면 앱이 직접 스트리밍한다(개발용).
USE_X_ACCEL=false

# ── 저장소 ────────────────────────────────────────────────────
STORAGE_ROOT=/srv/tdms
# STORAGE_ROOT/blobs, /mirror, /tmp 가 쓰인다

# ── 변환 도구 (워커) ──────────────────────────────────────────
PREVIEW_SOFFICE_PATH=/usr/bin/soffice
PREVIEW_ODA_PATH=
PREVIEW_TIMEOUT_SECONDS=180

# ── 백업 (워커) ───────────────────────────────────────────────
PG_DUMP_PATH=/usr/bin/pg_dump
BACKUP_ROOT=
