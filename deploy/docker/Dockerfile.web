# TDMS 웹 — SPA 정적 파일 + 앞단 nginx.
#
# 이 컨테이너가 바깥에서 보이는 TDMS 의 전부다. 호스트 nginx 는 TLS 만 벗기고
# 그대로 넘긴다. 그렇게 한 까닭:
#   - X-Accel-Redirect 파일 직송은 **응답을 받은 nginx** 가 처리한다. blob 볼륨을
#     이 컨테이너에 붙여 두면 호스트의 www-data 가 컨테이너가 쓴 파일을 읽을 수
#     있는지 따질 일이 없다.
#   - 화면·API·파일직송이 한 이미지 태그로 함께 움직인다. 롤백이 쪼개지지 않는다.
#   - 호스트 /etc/nginx 에 들어가는 설정이 최소가 된다 → sudo 가 필요한 자리가 준다.
#
# 빌드:  docker build -f deploy/docker/Dockerfile.web -t ghcr.io/quristyle/ghub-tdms-web:<tag> .
# BuildKit 전용 문법을 쓰지 않는다 — 운영서버에는 buildx 가 없다. 급할 때 거기서도 구워야 한다.

# ── 1) 빌드 ────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS build
# CI=true — 이게 없으면 두 번째 install 이 node_modules 를 지울지 물어보다가
# TTY 가 없어 ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY 로 죽는다.
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true
RUN corepack enable
WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/
COPY packages/web/package.json       packages/web/
RUN pnpm install --frozen-lockfile --filter "@tdms/web..."

COPY packages/contracts packages/contracts
COPY packages/web       packages/web
# 웹은 contracts 를 **타입으로만** 쓴다(번들에 Zod 를 끌어오지 않기 위해서다 —
# packages/web/src/lib/labels.ts 주석 참고). 그래서 contracts 빌드가 필요 없다.
RUN pnpm --filter "@tdms/web" build

# ── 2) 실행 ────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime
ENV TZ=Etc/UTC
COPY --from=build /app/packages/web/dist /srv/tdms/web
COPY deploy/docker/web-nginx.conf       /etc/nginx/conf.d/default.conf
# 00- 으로 시작해 default.conf 보다 먼저 읽힌다. http 컨텍스트라야 기존 맵에
# 합쳐진다 — 까닭은 파일 안에 적어 두었다.
COPY deploy/docker/mime-mjs.conf        /etc/nginx/conf.d/00-mime-mjs.conf
COPY deploy/docker/security-headers.conf /etc/nginx/security-headers.conf

EXPOSE 8080
HEALTHCHECK --interval=20s --timeout=4s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
