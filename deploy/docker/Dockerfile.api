# TDMS API — Fastify. 운영의 /api/ 를 전부 이 이미지가 받는다.
#
# 반드시 contracts 를 먼저 빌드한다. api/dist 는 @tdms/contracts 를
# **컴파일 산출물(dist/index.js)** 로 부르기 때문이다 — 원본 .ts 를 부르면
# node 가 읽지 못하고 ERR_MODULE_NOT_FOUND 로 죽는다.
# (contracts/package.json 의 exports: development→src, default→dist)
#
# 빌드:  docker build -f deploy/docker/Dockerfile.api -t ghcr.io/quristyle/ghub-tdms-api:<tag> .
# 맥락:  저장소 루트
# BuildKit 전용 문법을 쓰지 않는다 — 운영서버에는 buildx 가 없다. 급할 때 거기서도 구워야 한다.

# ── 1) 빌드 ────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS build
# CI=true — 이게 없으면 두 번째 install 이 node_modules 를 지울지 물어보다가
# TTY 가 없어 ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY 로 죽는다.
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true
RUN corepack enable
WORKDIR /app

# 매니페스트만 먼저 — 소스가 바뀌어도 의존성 계층의 캐시가 산다.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/
COPY packages/api/package.json       packages/api/
RUN pnpm install --frozen-lockfile --filter "@tdms/api..."

COPY packages/contracts packages/contracts
COPY packages/api       packages/api
RUN pnpm --filter "@tdms/contracts" --filter "@tdms/api" build

# 운영 의존성만 다시 깐다 — tsc·vitest 같은 개발 의존성을 이미지에 남기지 않는다.
RUN pnpm install --frozen-lockfile --prod --filter "@tdms/api..."

# ── 2) 실행 ────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production \
    TZ=Etc/UTC \
    API_LISTEN=0.0.0.0:8080
WORKDIR /app/packages/api

COPY --from=build /app/node_modules                   /app/node_modules
COPY --from=build /app/package.json /app/pnpm-workspace.yaml /app/
COPY --from=build /app/packages/contracts/package.json /app/packages/contracts/package.json
COPY --from=build /app/packages/contracts/dist         /app/packages/contracts/dist
# contracts 의 node_modules 도 가져온다 — pnpm 은 의존성 심링크를 **패키지마다** 둔다.
# 빠뜨리면 contracts/dist/common.js 가 zod 를 못 찾아 기동 직후 죽는다.
COPY --from=build /app/packages/contracts/node_modules /app/packages/contracts/node_modules
COPY --from=build /app/packages/api/package.json       /app/packages/api/package.json
COPY --from=build /app/packages/api/node_modules       /app/packages/api/node_modules
COPY --from=build /app/packages/api/dist               /app/packages/api/dist

# 마이그레이션을 api 패키지 **안**에 둔다. db/migrate.mjs 는 `pg` 를 자기 위치
# 기준으로 찾는데, 저장소 루트에 두면 운영 설치(--prod)에는 루트 node_modules 에
# pg 가 없어 못 찾는다. 여기 두면 packages/api/node_modules/pg 로 바로 풀린다.
COPY db /app/packages/api/db

# 업로드 원본·변환물이 쌓이는 곳. compose 가 호스트 디렉터리를 여기에 붙인다.
ENV STORAGE_ROOT=/srv/tdms
RUN mkdir -p /srv/tdms/blobs /srv/tdms/tmp && chown -R node:node /srv/tdms
USER node

EXPOSE 8080
# 컨테이너가 죽었는지 docker 가 스스로 안다 — compose 의 depends_on 과 배포 검증이 이걸 본다.
HEALTHCHECK --interval=20s --timeout=4s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8080/health').then(r=>r.ok?0:process.exit(1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]
