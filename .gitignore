# 비밀값 — 절대 커밋 금지
.env
.env.*
!.env.example
*.pem
*.key

# 의존성·빌드
node_modules/
dist/
# 우리 산출물만 막는다. `build/` 로 두면 packages/web/public/pdfjs/build/ 까지
# 삼킨다 — 거기는 PDF.js 배포본(pdf.mjs·pdf.worker.mjs)이라 소스다.
# 빠지면 뷰어가 globalThis.pdfjsLib 를 못 찾아 미리보기가 빈 화면이 된다.
packages/*/build/
.venv/
__pycache__/
*.pyc

# 도구
.turbo/
.vite/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# 로컬
.DS_Store
*.local

# 개발서버 제어판
devctl/run/
devctl/logs/

# 파이썬 패키지 메타
*.egg-info/

# 고객 전달물 — 레거시 사내 소스와 요건서가 들어 있다. 외부 저장소에 올리지 않는다.
docs/고객요청사항/

# 포털 사용자 동기화 입력물 — 실명·휴대전화·생년월일이 들어 있다. 저장소에 올리지 않는다.
# (import-users.mjs 는 경로를 인자로 받는다 — 파일은 서버에만 둔다)
*users*.json
!package.json
!package-lock.json

# blob 저장소 — DB 의 blobs 테이블과 짝인 런타임 상태다.
# 자리가 곧 내용의 sha256 이라(core/files.ts) git 이 되감으면 DB 와 어긋난다.
# 개발용 샘플은 db/tools/seed-files.mjs · seed-mdb.mjs 로 다시 만든다.
.storage/
